{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronary.org/schema/recipe.schema.json",
  "title": "neuronary recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "model",
    "neurons",
    "tags",
    "examples",
    "author",
    "date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "URL slug. Must match the file name (recipes/<id>.json)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "Hugging Face model id, e.g. Qwen/Qwen3.5-4B."
    },
    "neurons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "neuron",
          "dose"
        ],
        "properties": {
          "layer": {
            "type": "integer",
            "minimum": 0
          },
          "expert": {
            "type": "integer",
            "minimum": 0,
            "description": "MoE expert index. Omit for dense MLPs."
          },
          "neuron": {
            "type": "integer",
            "minimum": 0
          },
          "dose": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "description": "How doses are applied. Omit for the default (add, all tokens, median residual norm units).",
      "properties": {
        "op": {
          "enum": [
            "add",
            "mul"
          ],
          "default": "add"
        },
        "site": {
          "const": "mlp.down_proj.input",
          "default": "mlp.down_proj.input"
        },
        "normalization": {
          "enum": [
            "layer_residual_median_over_down_column_l2",
            "raw"
          ],
          "default": "layer_residual_median_over_down_column_l2"
        },
        "apply_to": {
          "enum": [
            "all_tokens",
            "generated_tokens",
            "prompt_tokens"
          ],
          "default": "all_tokens"
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "description": "Recommended generation settings for this recipe, e.g. a mild repetition penalty against loops.",
      "properties": {
        "repetition_penalty": {
          "type": "number",
          "minimum": 1,
          "maximum": 3
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "thinking": {
          "type": "boolean",
          "description": "Whether to enable the model's thinking mode, for models that have one. Default false."
        }
      }
    },
    "conditional": {
      "type": "object",
      "description": "Free-form description of anything fancier than a constant push (latches, triggers). Not applied by scripts/run.py."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 32
      }
    },
    "examples": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "output"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "base_output": {
            "type": "string",
            "description": "Unsteered reply to the same prompt, for comparison."
          },
          "scale": {
            "type": "number",
            "description": "Multiplier applied to every dose for this example. Default 1."
          },
          "generation": {
            "type": "object",
            "description": "How the output was produced, e.g. {\"decoding\": \"greedy\", \"thinking\": false, \"finish\": \"eos\"}."
          }
        }
      },
      "description": "Prompt/output pairs. The site's submit form and the issue bot require at least one."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other names the same neuron set goes by."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "Where the recipe was first posted."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  }
}
